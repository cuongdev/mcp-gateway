{
  "name": "mcp-gateway",
  "version": "0.1.0",
  "description": "MCP Gateway/Proxy with OIDC authentication, access control (RBAC/ABAC/ReBAC), and monitoring",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-gateway": "./bin/mcp-gateway"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm run copy:dashboard",
    "copy:dashboard": "mkdir -p dist/dashboard && cp src/dashboard/index.html dist/dashboard/index.html",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli/index.ts"
  },
  "keywords": [
    "mcp",
    "gateway",
    "proxy",
    "oidc",
    "access-control",
    "rbac",
    "abac"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@libsql/client": "^0.14.0",
    "@node-rs/argon2": "^2.0.2",
    "@scure/base": "^1.2.6",
    "casbin": "^5.30.0",
    "commander": "^12.1.0",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "prom-client": "^15.1.0",
    "uuid": "^10.0.0",
    "uuidv7": "^1.2.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
