{
  "name": "mcp-gateway",
  "version": "0.1.0",
  "description": "MCP Gateway/Proxy with OIDC authentication, access control (RBAC/ABAC/ReBAC), and monitoring",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm run copy:dashboard",
    "copy:dashboard": "mkdir -p dist/dashboard && cp src/dashboard/index.html dist/dashboard/index.html",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["mcp", "gateway", "proxy", "oidc", "access-control", "rbac", "abac"],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "casbin": "^5.30.0",
    "hono": "^4.6.0",
    "@hono/node-server": "^1.13.0",
    "jose": "^5.9.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "prom-client": "^15.1.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
