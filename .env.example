# ============================================================
# MCP Gateway — Environment Variables
# ============================================================

# Mode: "development" (no auth, full access) or "enterprise" (OIDC, strict ACL)
GATEWAY_MODE=development

# Gateway
GATEWAY_PORT=3000
GATEWAY_HOST=0.0.0.0
GATEWAY_MCP_PATH=/mcp
GATEWAY_API_PATH=/api

# OIDC (required in enterprise mode)
# OIDC_DISCOVERY_URL=https://your-provider.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=mcp-gateway
# OIDC_CLIENT_SECRET=your-secret
# OIDC_AUDIENCES=mcp-gateway

# Session cookie secret — REQUIRED in production / enterprise (OIDC) mode.
# Must be >= 32 chars. Generate one with: openssl rand -hex 32
# In development (no OIDC) a built-in dev default is used if unset.
# GATEWAY_SESSION_SECRET=

# Authorization (Casbin)
AUTHZ_MODEL_FILE=./config/policy.model.conf
AUTHZ_POLICY_FILE=./config/policy.csv

# Audit
AUDIT_ENABLED=true
AUDIT_LOG_PATH=./logs/audit.jsonl

# Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090

# Logging
LOG_LEVEL=info
NODE_ENV=development
